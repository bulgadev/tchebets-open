package views

import (
	"strconv"
)

templ Home(nav NavVM, marketCount int, markets []MarketCardVM) {
	@Layout("Início", nav) {
		<div class="border-b border-tche-border px-6 py-2.5 flex items-center gap-1.5 text-[13px] text-tche-muted flex-wrap">
			<span class="font-semibold text-tche-text mr-1.5">Como funciona:</span>
			<span>Escolha um jogo</span>
			<span class="text-tche-dim mx-1.5">→</span>
			<span>Aposte SIM ou NÃO</span>
			<span class="text-tche-dim mx-1.5">→</span>
			<span>Se acertar, você saca na hora</span>
			<div class="flex-1"></div>
			<span class="text-xs text-tche-green font-semibold tracking-wide">● { strconv.Itoa(marketCount) } mercados abertos</span>
		</div>
		<div class="max-w-[1100px] mx-auto px-6 py-7">
			<div class="flex items-center gap-4 mb-5 flex-wrap">
				<h1 class="font-[family-name:var(--font-condensed)] text-3xl font-extrabold tracking-tight">JOGOS EM ABERTO</h1>
				<div id="market-filters" class="flex gap-1.5 flex-wrap" x-data="{active:'todos'}">
					<button
						hx-get="/partials/markets?filter=todos"
						hx-target="#market-grid"
						hx-swap="innerHTML"
						class="bg-tche-gold text-tche-bg border-none px-3.5 py-1.5 font-[family-name:var(--font-condensed)] font-bold text-[13px] rounded"
					>TODOS</button>
					<button
						hx-get="/partials/markets?filter=hoje"
						hx-target="#market-grid"
						hx-swap="innerHTML"
						class="bg-transparent text-tche-muted border border-tche-border px-3.5 py-1.5 font-[family-name:var(--font-condensed)] font-semibold text-[13px] rounded hover:text-tche-text"
					>HOJE</button>
					<button
						hx-get="/partials/markets?filter=semana"
						hx-target="#market-grid"
						hx-swap="innerHTML"
						class="bg-transparent text-tche-muted border border-tche-border px-3.5 py-1.5 font-[family-name:var(--font-condensed)] font-semibold text-[13px] rounded hover:text-tche-text"
					>ESTA SEMANA</button>
				</div>
			</div>
			<div id="market-grid" class="grid gap-3" style="grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));">
				@MarketGrid(markets)
			</div>
		</div>
	}
}

templ MarketGrid(markets []MarketCardVM) {
	if len(markets) == 0 {
		<div class="col-span-full text-tche-muted text-sm py-10 text-center">Nenhum mercado aberto no momento.</div>
	}
	for _, m := range markets {
		@MarketCard(m)
	}
}
